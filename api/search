url":"/docs/interact/custom-themes#tokens","content":"Color tokens are **RGB triplets**, not `rgb()` values, so both `rgb(var(--primary))` and `rgba(var(--primary), 0.2)` work. Server `themeColors` / option `color` write `--primary` the same way."},"894":{"id":"/docs/interact/custom-themes-45","page_id":"/docs/interact/custom-themes","tags":[],"type":"text","url":"/docs/interact/custom-themes#tokens","content":"Token"},"895":{"id":"/docs/interact/custom-themes-46","page_id":"/docs/interact/custom-themes","tags":[],"type":"text","url":"/docs/interact/custom-themes#tokens","content":"Example"},"896":{"id":"/docs/interact/custom-themes-47","page_id":"/docs/interact/custom-themes","tags":[],"type":"text","url":"/docs/interact/custom-themes#tokens","content":"Use"},"897":{"id":"/docs/interact/custom-themes-48","page_id":"/docs/interact/custom-themes","tags":[],"type":"text","url":"/docs/interact/custom-themes#tokens","content":"`--primary`"},"898":{"id":"/docs/interact/custom-themes-49","page_id":"/docs/interact/custom-themes","tags":[],"type":"text","url":"/docs/interact/custom-themes#tokens","content":"`49, 164, 252`"},"899":{"id":"/docs/interact/custom-themes-50","page_id":"/docs/interact/custom-themes","tags":[],"type":"text","url":"/docs/interact/custom-themes#tokens","content":"Highlight, hold fill, selected border"},"900":{"id":"/docs/interact/custom-themes-51","page_id":"/docs/interact/custom-themes","tags":[],"type":"text","url":"/docs/interact/custom-themes#tokens","content":"`--on-accent`"},"901":{"id":"/docs/interact/custom-themes-52","page_id":"/docs/interact/custom-themes","tags":[],"type":"text","url":"/docs/interact/custom-themes#tokens","content":"`8, 11, 16`"},"902":{"id":"/docs/interact/custom-themes-53","page_id":"/docs/interact/custom-themes","tags":[],"type":"text","url":"/docs/interact/custom-themes#tokens","content":"Text sitting on a filled `--primary` surface"},"903":{"id":"/docs/interact/custom-themes-54","page_id":"/docs/interact/custom-themes","tags":[],"type":"text","url":"/docs/interact/custom-themes#tokens","content":"`--text`"},"904":{"id":"/docs/interact/custom-themes-55","page_id":"/docs/interact/custom-themes","tags":[],"type":"text","url":"/docs/interact/custom-themes#tokens","content":"`236, 241, 247`"},"905":{"id":"/docs/interact/custom-themes-56","page_id":"/docs/interact/custom-themes","tags":[],"type":"text","url":"/docs/interact/custom-themes#tokens","content":"Labels"},"906":{"id":"/docs/interact/custom-themes-57","page_id":"/docs/interact/custom-themes","tags":[],"type":"text","url":"/docs/interact/custom-themes#tokens","content":"`--text-muted`"},"907":{"id":"/docs/interact/custom-themes-58","page_id":"/docs/interact/custom-themes","tags":[],"type":"text","url":"/docs/interact/custom-themes#tokens","content":"`156, 170, 186`"},"908":{"id":"/docs/interact/custom-themes-59","page_id":"/docs/interact/custom-themes","tags":[],"type":"text","url":"/docs/interact/custom-themes#tokens","content":"Idle icons, Hold chip"},"909":{"id":"/docs/interact/custom-themes-60","page_id":"/docs/interact/custom-themes","tags":[],"type":"text","url":"/docs/interact/custom-themes#tokens","content":"`--surface`"},"910":{"id":"/docs/interact/custom-themes-61","page_id":"/docs/interact/custom-themes","tags":[],"type":"text","url":"/docs/interact/custom-themes#tokens","content":"`10, 14, 20`"},"911":{"id":"/docs/interact/custom-themes-62","page_id":"/docs/interact/custom-themes","tags":[],"type":"text","url":"/docs/interact/custom-themes#tokens","content":"Panel fill"},"912":{"id":"/docs/interact/custom-themes-63","page_id":"/docs/interact/custom-themes","tags":[],"type":"text","url":"/docs/interact/custom-themes#tokens","content":"`--ink`"},"913":{"id":"/docs/interact/custom-themes-64","page_id":"/docs/interact/custom-themes","tags":[],"type":"text","url":"/docs/interact/custom-themes#tokens","content":"`8, 11, 16`"},"914":{"id":"/docs/interact/custom-themes-65","page_id":"/docs/interact/custom-themes","tags":[],"type":"text","url":"/docs/interact/custom-themes#tokens","content":"Dark insets"},"915":{"id":"/docs/interact/custom-themes-66","page_id":"/docs/interact/custom-themes","tags":[],"type":"text","url":"/docs/interact/custom-themes#tokens","content":"`--hairline`"},"916":{"id":"/docs/interact/custom-themes-67","page_id":"/docs/interact/custom-themes","tags":[],"type":"text","url":"/docs/interact/custom-themes#tokens","content":"`220, 230, 242`"},"917":{"id":"/docs/interact/custom-themes-68","page_id":"/docs/interact/custom-themes","tags":[],"type":"text","url":"/docs/interact/custom-themes#tokens","content":"Borders, usually with `--hairline-a`"},"918":{"id":"/docs/interact/custom-themes-69","page_id":"/docs/interact/custom-themes","tags":[],"type":"text","url":"/docs/interact/custom-themes#tokens","content":"`--panel-a`"},"919":{"id":"/docs/interact/custom-themes-70","page_id":"/docs/interact/custom-themes","tags":[],"type":"text","url":"/docs/interact/custom-themes#tokens","content":"`0.92`"},"920":{"id":"/docs/interact/custom-themes-71","page_id":"/docs/interact/custom-themes","tags":[],"type":"text","url":"/docs/interact/custom-themes#tokens","content":"Panel opacity"},"921":{"id":"/docs/interact/custom-themes-72","page_id":"/docs/interact/custom-themes","tags":[],"type":"text","url":"/docs/interact/custom-themes#tokens","content":"`--font`"},"922":{"id":"/docs/interact/custom-themes-73","page_id":"/docs/interact/custom-themes","tags":[],"type":"text","url":"/docs/interact/custom-themes#tokens","content":"`\"DINPRO\", \"Segoe UI\", sans-serif`"},"923":{"id":"/docs/interact/custom-themes-74","page_id":"/docs/interact/custom-themes","tags":[],"type":"text","url":"/docs/interact/custom-themes#tokens","content":"Typeface"},"924":{"id":"/docs/interact/custom-themes-75","page_id":"/docs/interact/custom-themes","tags":[],"type":"text","url":"/docs/interact/custom-themes#tokens","content":"`--on-accent` should contrast with `--primary`. Light accents need a dark `--on-accent`; dark accents need a light one. JS will recompute `--on-accent` when a global `themeColor` or per-option `color` is applied."},"925":{"id":"/docs/interact/custom-themes-76","page_id":"/docs/interact/custom-themes","tags":[],"type":"text","url":"/docs/interact/custom-themes#tokens","content":"Root `font-size` is `1vh`, so `1rem` is 1% of the viewport height. Size the E key and rows in `rem`, not `px`. Offset the list from the key with `--options-x` on `#options-wrapper` (default `2.6rem`)."},"926":{"id":"/docs/interact/custom-themes-77","page_id":"/docs/interact/custom-themes","tags":[],"type":"text","url":"/docs/interact/custom-themes#what-to-style","content":"Copy `web/themes/modern.css` or `web/themes/minimal.css` and rename `[data-theme=\"...\"]`. At minimum, cover:"},"927":{"id":"/docs/interact/custom-themes-78","page_id":"/docs/interact/custom-themes","tags":[],"type":"text","url":"/docs/interact/custom-themes#what-to-style","content":"**`#interact-container` / `#interact-key`**: size, border, background, letter"},"928":{"id":"/docs/interact/custom-themes-79","page_id":"/docs/interact/custom-themes","tags":[],"type":"text","url":"/docs/interact/custom-themes#what-to-style","content":"**`#interact-progress`**: usually `left/right/bottom: 0; width: 100%; height: 0` with `background: rgb(var(--primary))`. JS sets `height` while the player holds E. `modern` also strokes `.hold-ring`."},"929":{"id":"/docs/interact/custom-themes-80","page_id":"/docs/interact/custom-themes","tags":[],"type":"text","url":"/docs/interact/custom-themes#what-to-style","content":"**`.option-container`**: row chrome"},"930":{"id":"/docs/interact/custom-themes-81","page_id":"/docs/interact/custom-themes","tags":[],"type":"text","url":"/docs/interact/custom-themes#what-to-style","content":"**`.option-container.highlighted`**: selected row. Put `--primary` here, not on every idle row."},"931":{"id":"/docs/interact/custom-themes-82","page_id":"/docs/interact/custom-themes","tags":[],"type":"text","url":"/docs/interact/custom-themes#what-to-style","content":"**`.option-icon`, `.option-label`, `.option-hold`**: idle and `.highlighted` colors"},"932":{"id":"/docs/interact/custom-themes-83","page_id":"/docs/interact/custom-themes","tags":[],"type":"text","url":"/docs/interact/custom-themes#what-to-style","content":"**`body.is-cooldown`**: dim the key so the hourglass reads as blocked"},"933":{"id":"/docs/interact/custom-themes-84","page_id":"/docs/interact/custom-themes","tags":[],"type":"text","url":"/docs/interact/custom-themes#what-to-style","content":"`.animated-background` is a full-row fill used by `legacy` and `retro`. Most themes hide it with `display: none`."},"934":{"id":"/docs/interact/custom-themes-85","page_id":"/docs/interact/custom-themes","tags":[],"type":"text","url":"/docs/interact/custom-themes#compact-interact","content":"When compact, global CSS strips border, background, and shadow from `.interact-summary` and draws `INTERACT` as uppercase outlined type. Keep row decorations on `.option-container` only. Pseudos on `.interact-summary` will still show on the compact label."},"935":{"id":"/docs/interact/custom-themes-86","page_id":"/docs/interact/custom-themes","tags":[],"type":"text","url":"/docs/interact/custom-themes#compact-interact","content":"To force compact label color (light themes need this so it stays white):"},"936":{"id":"/docs/interact/custom-themes-87","page_id":"/docs/interact/custom-themes","tags":[],"type":"text","url":"/docs/interact/custom-themes#hold-contrast","content":"While holding, the letter keeps its idle color and gets a `--on-accent` stroke so it stays readable as `--primary` fills the key. If the fill and the letter are the same color, that stroke is what keeps E visible."},"937":{"id":"/docs/interact/custom-themes-88","page_id":"/docs/interact/custom-themes","tags":[],"type":"text","url":"/docs/interact/custom-themes#dui-limits","content":"This prompt is a world sprite, not a fullscreen NUI overlay."},"938":{"id":"/docs/interact/custom-themes-89","page_id":"/docs/interact/custom-themes","tags":[],"type":"text","url":"/docs/interact/custom-themes#dui-limits","content":"Keep `html, body` background transparent. `style.css` already does this."},"939":{"id":"/docs/interact/custom-themes-90","page_id":"/docs/interact/custom-themes","tags":[],"type":"text","url":"/docs/interact/custom-themes#dui-limits","content":"`backdrop-filter` cannot blur GTA. CEF only composites the DUI texture, so a blur with nothing behind it paints black. Use solid or slightly transparent `--surface` fills."},"940":{"id":"/docs/interact/custom-themes-91","page_id":"/docs/interact/custom-themes","tags":[],"type":"text","url":"/docs/interact/custom-themes#dui-limits","content":"Keep the layout compact. Large shadows and oversized rows read poorly in the world."},"941":{"id":"/docs/interact/custom-themes-92","page_id":"/docs/interact/custom-themes","tags":[],"type":"text","url":"/docs/interact/custom-themes#dui-limits","content":"Prefer `rem` over `px`. Animate `transform` and `opacity` only."},"942":{"id":"/docs/interact/custom-themes-93","page_id":"/docs/interact/custom-themes","tags":[],"type":"text","url":"/docs/interact/custom-themes#dui-limits","content":"DINPRO is self-hosted in `web/fonts/`. To use another face, add an `@font-face` in your theme file (see `legacy.css`) and set `--font`."},"943":{"id":"/docs/interact/custom-themes-94","page_id":"/docs/interact/custom-themes","tags":[],"type":"text","url":"/docs/interact/custom-themes#dui-limits","content":"Built-in themes live in `web/themes/`. `modern.css` is the default HUD. `cyber.css`, `vice.css`, and `kawaii.css` show how far you can push shape without changing the HTML."},"944":{"id":"/docs/interact","page_id":"/docs/interact","type":"page","content":"Sleepless Interact","breadcrumbs":["Docs","Free Resources","Interact"],"tags":[],"url":"/docs/interact"},"945":{"id":"/docs/interact-0","page_id":"/docs/interact","type":"heading","tags":
Client#world-targets","content":"One group per point, while the player is in range of that point"},"3184":{"id":"/docs/prompts/exports/Client-125","page_id":"/docs/prompts/exports/Client","tags":[],"type":"text","url":"/docs/prompts/exports/Client#world-targets","content":"Local entity or network id"},"3185":{"id":"/docs/prompts/exports/Client-126","page_id":"/docs/prompts/exports/Client","tags":[],"type":"text","url":"/docs/prompts/exports/Client#world-targets","content":"That entity's prompts, plus model and global prompts when it is the closest match"},"3186":{"id":"/docs/prompts/exports/Client-127","page_id":"/docs/prompts/exports/Client","tags":[],"type":"text","url":"/docs/prompts/exports/Client#world-targets","content":"Model"},"3187":{"id":"/docs/prompts/exports/Client-128","page_id":"/docs/prompts/exports/Client","tags":[],"type":"text","url":"/docs/prompts/exports/Client#world-targets","content":"The closest entity of that model"},"3188":{"id":"/docs/prompts/exports/Client-129","page_id":"/docs/prompts/exports/Client","tags":[],"type":"text","url":"/docs/prompts/exports/Client#world-targets","content":"Global ped, vehicle, object, or player"},"3189":{"id":"/docs/prompts/exports/Client-130","page_id":"/docs/prompts/exports/Client","tags":[],"type":"text","url":"/docs/prompts/exports/Client#world-targets","content":"The closest entity of that type"},"3190":{"id":"/docs/prompts/exports/Client-131","page_id":"/docs/prompts/exports/Client","tags":[],"type":"text","url":"/docs/prompts/exports/Client#world-targets","content":"Model prompts and global prompts attach to that closest entity. Prompts registered on the entity itself are merged into the same group, specific ones first, then model, then global. A second car nearby does not get a second copy of a global vehicle prompt."},"3191":{"id":"/docs/prompts/exports/Client-132","page_id":"/docs/prompts/exports/Client","tags":[],"type":"text","url":"/docs/prompts/exports/Client#world-targets","content":"`canInterac
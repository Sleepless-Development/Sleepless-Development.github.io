figuration#options-explained","content":"`boolean`"},"680":{"id":"/docs/interact/configuration-68","page_id":"/docs/interact/configuration","tags":[],"type":"text","url":"/docs/interact/configuration#options-explained","content":"`true`"},"681":{"id":"/docs/interact/configuration-69","page_id":"/docs/interact/configuration","tags":[],"type":"text","url":"/docs/interact/configuration#options-explained","content":"Compact multi-option prompt. See Compact prompt."},"682":{"id":"/docs/interact/configuration-70","page_id":"/docs/interact/configuration","tags":[],"type":"text","url":"/docs/interact/configuration#options-explained","content":"`compactIdleMs`"},"683":{"id":"/docs/interact/configuration-71","page_id":"/docs/interact/configuration","tags":[],"type":"text","url":"/docs/interact/configuration#options-explained","content":"`number`"},"684":{"id":"/docs/interact/configuration-72","page_id":"/docs/interact/configuration","tags":[],"type":"text","url":"/docs/interact/configuration#options-explained","content":"`2500`"},"685":{"id":"/docs/interact/configuration-73","page_id":"/docs/interact/configuration","tags":[],"type":"text","url":"/docs/interact/configuration#options-explained","content":"Idle time in milliseconds before a compact list collapses. Minimum `500`."},"686":{"id":"/docs/interact/configuration-74","page_id":"/docs/interact/configuration","tags":[],"type":"text","url":"/docs/interact/configuration#options-explained","content":"`defaultInteractKey`"},"687":{"id":"/docs/interact/configuration-75","page_id":"/docs/interact/configuration","tags":[],"type":"text","url":"/docs/interact/configuration#options-explained","content":"`string`"},"688":{"id":"/docs/interact/configuration-76","page_id":"/docs/interact/configuration","tags":[],"type":"text","url":"/docs/interact/configuration#options-explained","content":"`'E'`"},"689":{"id":"/docs/interact/configuration-77","page_id":"/docs/interact/configuration","tags":[],"type":"text","url":"/docs/interact/configuration#options-explained","content":"Default mapping for the interact action. Players can rebind it in GTA Settings; the prompt shows the live key."},"690":{"id":"/docs/interact/configuration-78","page_id":"/docs/interact/configuration","tags":[],"type":"text","url":"/docs/interact/configuration#options-explained","content":"`IndicatorSprite`"},"691":{"id":"/docs/interact/configuration-79","page_id":"/docs/interact/configuration","tags":[],"type":"text","url":"/docs/interact/configuration#options-explained","content":"`table`"},"692":{"id":"/docs/interact/configuration-80","page_id":"/docs/interact/configuration","tags":[],"type":"text","url":"/docs/interact/configuration#options-explained","content":"radio PNG, white"},"693":{"id":"/docs/interact/configuration-81","page_id":"/docs/interact/configuration","tags":[],"type":"text","url":"/docs/interact/configuration#options-explained","content":"Distant marker. `file` is a PNG in this resource. `color` tints it (`{ 255, 255, 255 }` stays white). `scale` is world size. Omit `file` and set `dict` / `txt` to use a GTA texture instead."},"694":{"id":"/docs/interact/configuration-82","page_id":"/docs/interact/configuration","tags":[],"type":"text","url":"/docs/interact/configuration#options-explained","content":"`CenterDot`"},"695":{"id":"/docs/interact/configuration-83","page_id":"/docs/interact/configuration","tags":[],"type":"text","url":"/docs/interact/configuration#options-explained","content":"`table`"},"696":{"id":"/docs/interact/configuration-84","page_id":"/docs/interact/configuration","tags":[],"type":"text","url":"/docs/interact/configuration#options-explained","content":"`mpcarhud` colour icon"},"697":{"id":"/docs/interact/configuration-85","page_id":"/docs/interact/configuration","tags":[],"type":"text","url":"/docs/interact/configuration#options-explained","content":"Screen-center circle while at least one usable interact is nearby. Set `enabled` to `false` to hide it. `color` tints the sprite. `scale` is s
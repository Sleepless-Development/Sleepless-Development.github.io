pe":"text","url":"/docs/interact/custom-themes#tokens","content":"`156, 170, 186`"},"477":{"id":"/docs/interact/custom-themes-59","page_id":"/docs/interact/custom-themes","tags":[],"type":"text","url":"/docs/interact/custom-themes#tokens","content":"Idle icons, Hold chip"},"478":{"id":"/docs/interact/custom-themes-60","page_id":"/docs/interact/custom-themes","tags":[],"type":"text","url":"/docs/interact/custom-themes#tokens","content":"`--surface`"},"479":{"id":"/docs/interact/custom-themes-61","page_id":"/docs/interact/custom-themes","tags":[],"type":"text","url":"/docs/interact/custom-themes#tokens","content":"`10, 14, 20`"},"480":{"id":"/docs/interact/custom-themes-62","page_id":"/docs/interact/custom-themes","tags":[],"type":"text","url":"/docs/interact/custom-themes#tokens","content":"Panel fill"},"481":{"id":"/docs/interact/custom-themes-63","page_id":"/docs/interact/custom-themes","tags":[],"type":"text","url":"/docs/interact/custom-themes#tokens","content":"`--ink`"},"482":{"id":"/docs/interact/custom-themes-64","page_id":"/docs/interact/custom-themes","tags":[],"type":"text","url":"/docs/interact/custom-themes#tokens","content":"`8, 11, 16`"},"483":{"id":"/docs/interact/custom-themes-65","page_id":"/docs/interact/custom-themes","tags":[],"type":"text","url":"/docs/interact/custom-themes#tokens","content":"Dark insets"},"484":{"id":"/docs/interact/custom-themes-66","page_id":"/docs/interact/custom-themes","tags":[],"type":"text","url":"/docs/interact/custom-themes#tokens","content":"`--hairline`"},"485":{"id":"/docs/interact/custom-themes-67","page_id":"/docs/interact/custom-themes","tags":[],"type":"text","url":"/docs/interact/custom-themes#tokens","content":"`220, 230, 242`"},"486":{"id":"/docs/interact/custom-themes-68","page_id":"/docs/interact/custom-themes","tags":[],"type":"text","url":"/docs/interact/custom-themes#tokens","content":"Borders, usually with `--hairline-a`"},"487":{"id":"/docs/interact/custom-themes-69","page_id":"/docs/interact/custom-t
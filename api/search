ange"},"1145":{"id":"/docs/lootbox/configuration-166","page_id":"/docs/lootbox/configuration","tags":[],"type":"text","url":"/docs/lootbox/configuration#default-rarity-distribution","content":"Common"},"1146":{"id":"/docs/lootbox/configuration-167","page_id":"/docs/lootbox/configuration","tags":[],"type":"text","url":"/docs/lootbox/configuration#default-rarity-distribution","content":"\\~80%"},"1147":{"id":"/docs/lootbox/configuration-168","page_id":"/docs/lootbox/configuration","tags":[],"type":"text","url":"/docs/lootbox/configuration#default-rarity-distribution","content":"17+"},"1148":{"id":"/docs/lootbox/configuration-169","page_id":"/docs/lootbox/configuration","tags":[],"type":"text","url":"/docs/lootbox/configuration#default-rarity-distribution","content":"Uncommon"},"1149":{"id":"/docs/lootbox/configuration-170","page_id":"/docs/lootbox/configuration","tags":[],"type":"text","url":"/docs/lootbox/configuration#default-rarity-distribution","content":"\\~16%"},"1150":{"id":"/docs/lootbox/configuration-171","page_id":"/docs/lootbox/configuration","tags":[],"type":"text","url":"/docs/lootbox/configuration#default-rarity-distribution","content":"4 - 16.99"},"1151":{"id":"/docs/lootbox/configuration-172","page_id":"/docs/lootbox/configuration","tags":[],"type":"text","url":"/docs/lootbox/configuration#default-rarity-distribution","content":"Rare"},"1152":{"id":"/docs/lootbox/configuration-173","page_id":"/docs/lootbox/configuration","tags":[],"type":"text","url":"/docs/lootbox/configuration#default-rarity-distribution","content":"\\~3.1%"},"1153":{"id":"/docs/lootbox/configuration-174","page_id":"/docs/lootbox/configuration","tags":[],"type":"text","url":"/docs/lootbox/configuration#default-rarity-distribution","content":"1 - 3.99"},"1154":{"id":"/docs/lootbox/configuration-175","page_id":"/docs/lootbox/configuration","tags":[],"type":"text","url":"/docs/lootbox/configuration#default-rarity-distribution","content":"Epic"},"1155":{"id":"/docs/lootbox/configuration-
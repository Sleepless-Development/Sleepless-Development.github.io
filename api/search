ract/configuration#options-explained","content":"`indicator`"},"771":{"id":"/docs/interact/configuration-84","page_id":"/docs/interact/configuration","tags":[],"type":"text","url":"/docs/interact/configuration#options-explained","content":"`string`"},"772":{"id":"/docs/interact/configuration-85","page_id":"/docs/interact/configuration","tags":[],"type":"text","url":"/docs/interact/configuration#options-explained","content":"`'ripple'`"},"773":{"id":"/docs/interact/configuration-86","page_id":"/docs/interact/configuration","tags":[],"type":"text","url":"/docs/interact/configuration#options-explained","content":"Distant marker. `sprite` uses `IndicatorSprite`. Any other id loads `web/indicators/<id>.css`. A missing id falls back to the sprite."},"774":{"id":"/docs/interact/configuration-87","page_id":"/docs/interact/configuration","tags":[],"type":"text","url":"/docs/interact/configuration#options-explained","content":"`indicatorScale`"},"775":{"id":"/docs/interact/configuration-88","page_id":"/docs/interact/configuration","tags":[],"type":"text","url":"/docs/interact/configuration#options-explained","content":"`number`"},"776":{"id":"/docs/interact/configuration-89","page_id":"/docs/interact/configuration","tags":[],"type":"text","url":"/docs/interact/configuration#options-explained","content":"`0.02`"},"777":{"id":"/docs/interact/configuration-90","page_id":"/docs/interact/configuration","tags":[],"type":"text","url":"/docs/interact/configuration#options-explained","content":"World size of a CSS marker. Every CSS id uses this same scale."},"778":{"id":"/docs/interact/configuration-91","page_id":"/docs/interact/configuration","tags":[],"type":"text","url":"/docs/interact/configuration#options-explained","content":"`IndicatorSprite`"},"779":{"id":"/docs/interact/configuration-92","page_id":"/docs/interact/configuration","tags":[],"type":"text","url":"/docs/interact/configuration#options-explained","content":"`table`"},"780":{"id":"/docs/interact/configuration-93","page_id":"/docs/interact/configuration","tags":[],"type":"text","url":"/docs/interact/configuration#options-explained","content":"white circle"},"781":{"id":"/docs/interact/configuration-94","page_id":"/docs/interact/configuration","tags":[],"type":"text","url":"/docs/interact/configuration#options-explained","content":"Streamed marker used when `indicator` is `sprite`, and the fallback when a CSS id is missing. `dict` and `txt` are a GTA texture. `color` tints it. `scale` is its world size."},"782":{"id":"/docs/interact/configuration-95","page_id":"/docs/interact/configuration","tags":[],"type":"text","url":"/docs/interact/configuration#options-explained","content":"`CenterDot`"},"783":{"id":"/docs/interact/configuration-96","page_id":"/docs/interact/configuration","tags":[],"type":"text","url":"/docs/interact/configuration#options-explained","content":"`table`"},"784":{"id":"/docs/interact/configuration-97","page_id":"/docs/interact/configuration","tags":[],"type":"text","url":"/docs/interact/configuration#options-explained","content":"`mpcarhud` colour icon"},"785":{"id":"/docs/interact/configuration-98","page_id":"/docs/interact/configuration","tags":[],"type":"text","url":"/docs/interact/configuration#options-explained","content":"Screen-center circle while at least one usable interact is nearby. Set `enabled` to `false` to hide it. `color` tints the sprite. `scale` is screen size, `x` / `y` are 0–1 screen position. Optional `file` loads a PNG instead of `dict` / `txt`."},"786":{"id":"/docs/interact/configuration-99","page_id":"/docs/interact/configuration","tags":[],"type":"text","url":"/docs/interact/configuration#options-explained","content":"`useShowKeyBind`"},"787":{"id":"/docs/interact/configuration-100","page_id":"/docs/interact/configuration","tags":[],"type":"text","url":"/docs/interact/configuration#options-explained","content":"`boolean`"},"788":{"id":"/docs/interact/configuration-101","page_id":"/docs/interact/configuration","tags":[],"type":"text","ur
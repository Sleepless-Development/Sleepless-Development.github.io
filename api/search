s"},"3388":{"id":"/docs/prompts/exports/Client-150","page_id":"/docs/prompts/exports/Client","tags":[],"type":"text","url":"/docs/prompts/exports/Client#returns-1","content":"The id is stable for the same point. A later `addCoords` on that point merges prompts. The same `name` from the same resource replaces the previous prompt."},"3389":{"id":"/docs/prompts/exports/Client-151","page_id":"/docs/prompts/exports/Client","tags":[],"type":"text","url":"/docs/prompts/exports/Client#removecoords","content":"Omit `names` to remove every prompt the calling resource added to that id. `id` can be the array returned by `addCoords`."},"3390":{"id":"/docs/prompts/exports/Client-152","page_id":"/docs/prompts/exports/Client","tags":[],"type":"text","url":"/docs/prompts/exports/Client#addlocalentity","content":"Prompts for one local entity, or a list of them. The handle must already exist."},"3391":{"id":"/docs/prompts/exports/Client-153","page_id":"/docs/prompts/exports/Client","tags":[],"type":"text","url":"/docs/prompts/exports/Client#addentity","content":"Prompts for a network id. The entity can stream in after the call."},"3392":{"id":"/docs/prompts/exports/Client-154","page_id":"/docs/prompts/exports/Client","tags":[],"type":"text","url":"/docs/prompts/exports/Client#addmodel","content":"Prompts for every entity of a model. While several are in range, the closest one shows the group."},"3393":{"id":"/docs/prompts/exports/Client-155","page_id":"/docs/prompts/exports/Client","tags":[],"type":"text","url":"/docs/prompts/exports/Client#addmodel","content":"Model names and hashes both work."},"3394":{"id":"/docs/prompts/exports/Client-156","page_id":"/docs/prompts/exports/Client","tags":[],"type":"text","url":"/docs/prompts/exports/Client#addglobalped","content":"Prompts for the closest ped. Player peds are skipped."},"3395":{"id":"/docs/prompts/exports/Client-157","page_id":"/docs/prompts/exports/Client","tags":[],"type":"text","url":"/docs/prompts/exports/Client#addglobalped","c
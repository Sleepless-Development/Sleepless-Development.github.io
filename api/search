emes-8","page_id":"/docs/interact/custom-themes","type":"heading","tags":[],"url":"/docs/interact/custom-themes#hold-contrast","content":"Hold contrast"},"858":{"id":"/docs/interact/custom-themes-9","page_id":"/docs/interact/custom-themes","type":"heading","tags":[],"url":"/docs/interact/custom-themes#starter","content":"Starter"},"859":{"id":"/docs/interact/custom-themes-10","page_id":"/docs/interact/custom-themes","type":"heading","tags":[],"url":"/docs/interact/custom-themes#dui-limits","content":"DUI limits"},"860":{"id":"/docs/interact/custom-themes-11","page_id":"/docs/interact/custom-themes","tags":[],"type":"text","url":"/docs/interact/custom-themes","content":"Each look is a CSS file. The Lua config only picks an id and an accent. Copy a built-in theme, rename the selector, then restyle the E key and option rows."},"861":{"id":"/docs/interact/custom-themes-12","page_id":"/docs/interact/custom-themes","tags":[],"type":"text","url":"/docs/interact/custom-themes#create-the-stylesheet-step","content":"Add `web/themes/<id>.css`. The id must be lowercase with no spaces (`ember`, `hospital`, `mytheme`). Every rule is scoped to that id:"},"862":{"id":"/docs/interact/custom-themes-13","page_id":"/docs/interact/custom-themes","tags":[],"type":"text","url":"/docs/interact/custom-themes#create-the-stylesheet-step","content":"Unknown ids are loaded from `web/themes/<id>.css` automatically. If the file is missing, the prompt falls back to `modern`."},"863":{"id":"/docs/interact/custom-themes-14","page_id":"/docs/interact/custom-themes","tags":[],"type":"text","url":"/docs/interact/custom-themes#point-config-at-it-step","content":"In `client/modules/config.lua`:"},"864":{"id":"/docs/interact/custom-themes-15","page_id":"/docs/interact/custom-themes","tags":[],"type":"text","url":"/docs/interact/custom-themes#point-config-at-it-step","content":"`themeColors` is the default HUD accent. Leave `config.themeColor = nil` so this color is not forced onto every other theme. CSS distant markers use that same accent as their second color. The `sprite` marker uses `config.IndicatorSprite.color`."},"865":{"id":"/docs/interact/custom-themes-16","page_id":"/docs/interact/custom-themes","tags":[],"type":"text","url":"/docs/interact/custom-themes#preview-in-a-browser-step","content":"Serve the `web/` folder and open:"},"866":{"id":"/docs/interact/custom-themes-17","page_id":"/docs/interact/custom-themes","tags":[],"type":"text","url":"/docs/interact/custom-themes#preview-in-a-browser-step","content":"Query"},"867":{"id":"/docs/interact/custom-themes-18","page_id":"/docs/interact/custom-themes","tags":[],"type":"text","url":"/docs/interact/custom-themes#preview-in-a-browser-step","content":"Effect"},"868":{"id":"/docs/interact/custom-themes-19","page_id":"/docs/interact/custom-themes","tags":[],"type":"text","url":"/docs/interact/custom-themes#preview-in-a-browser-step","content":"`theme=<id>`"},"869":{"id":"/docs/interact/custom-themes-20","page_id":"/docs/interact/custom-themes","tags":[],"type":"text","url":"/docs/interact/custom-themes#preview-in-a-browser-step","content":"Load that theme"},"870":{"id":"/docs/interact/custom-themes-21","page_id":"/docs/interact/custom-themes","tags":[],"type":"text","url":"/docs/interact/custom-themes#preview-in-a-browser-step","content":"`compact=0`"},"871":{"id":"/docs/interact/custom-themes-22","page_id":"/docs/interact/custom-themes","tags":[],"type":"text","url":"/docs/interact/custom-themes#preview-in-a-browser-step","content":"Always show the full option list"},"872":{"id":"/docs/interact/custom-themes-23","page_id":"/docs/interact/custom-themes","tags":[],"type":"text","url":"/docs/interact/custom-themes#preview-in-a-browser-step","content":"`state=open`"},"873":{"id":"/docs/interact/custom-themes-24","page_id":"/docs/interact/custom-themes","tags":[],"type":"text","url":"/docs/interact/custom-themes#preview-in-a-browser-step","content":"Expand the compact prompt"},"874":{"id":"/docs/interact/custom-them
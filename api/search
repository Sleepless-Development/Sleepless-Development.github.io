eract/custom-themes","tags":[],"type":"text","url":"/docs/interact/custom-themes#tokens","content":"`0.92`"},"522":{"id":"/docs/interact/custom-themes-71","page_id":"/docs/interact/custom-themes","tags":[],"type":"text","url":"/docs/interact/custom-themes#tokens","content":"Panel opacity"},"523":{"id":"/docs/interact/custom-themes-72","page_id":"/docs/interact/custom-themes","tags":[],"type":"text","url":"/docs/interact/custom-themes#tokens","content":"`--font`"},"524":{"id":"/docs/interact/custom-themes-73","page_id":"/docs/interact/custom-themes","tags":[],"type":"text","url":"/docs/interact/custom-themes#tokens","content":"`\"DINPRO\", \"Segoe UI\", sans-serif`"},"525":{"id":"/docs/interact/custom-themes-74","page_id":"/docs/interact/custom-themes","tags":[],"type":"text","url":"/docs/interact/custom-themes#tokens","content":"Typeface"},"526":{"id":"/docs/interact/custom-themes-75","page_id":"/docs/interact/custom-themes","tags":[],"type":"text","url":"/docs/interact/custom-themes#tokens","content":"`--on-accent` should contrast with `--primary`. Light accents need a dark `--on-accent`; dark accents need a light one. JS will recompute `--on-accent` when a global `themeColor` or per-option `color` is applied."},"527":{"id":"/docs/interact/custom-themes-76","page_id":"/docs/interact/custom-themes","tags":[],"type":"text","url":"/docs/interact/custom-themes#tokens","content":"Root `font-size` is `1vh`, so `1rem` is 1% of the viewport height. Size the E key and rows in `rem`, not `px`. Offset the list from the key with `--options-x` on `#options-wrapper` (default `2.6rem`)."},"528":{"id":"/docs/interact/custom-themes-77","page_id":"/docs/interact/custom-themes","tags":[],"type":"text","url":"/docs/interact/custom-themes#what-to-style","content":"Copy `web/themes/modern.css` or `web/themes/minimal.css` and rename `[data-theme=\"...\"]`. At minimum, cover:"},"529":{"id":"/docs/interact/custom-themes-78","page_id":"/docs/interact/custom-themes","tags":[],"type":"text","url":"/docs/interact/custom-themes#what-to-style","content":"**`#interact-container` / `#interact-key`** — size, border, background, letter"},"530":{"id":"/docs/interact/custom-themes-79","page_id":"/docs/interact/custom-themes","tags":[],"type":"text","url":"/docs/interact/custom-themes#what-to-style","content":"**`#interact-progress`** — usually `left/right/bottom: 0; width: 100%; height: 0` with `background: rgb(var(--primary))`. JS only changes `height`."},"531":{"id":"/docs/interact/custom-themes-80","page_id":"/docs/interact/custom-themes","tags":[],"type":"text","url":"/docs/interact/custom-themes#what-to-style","content":"**`.option-container`** — row chrome"},"532":{"id":"/docs/interact/custom-themes-81","page_id":"/docs/interact/custom-themes","tags":[],"type":"text","url":"/docs/interact/custom-themes#what-to-style","content":"**`.option-container.highlighted`** — selected row. Put `--primary` here, not on every idle row."},"533":{"id":"/docs/interact/custom-themes-82","page_id":"/docs/interact/custom-themes","tags":[],"type":"text","url":"/docs/interact/custom-themes#what-to-style","content":"**`.option-icon`, `.option-label`, `.option-hold`** — idle and `.highlighted` colors"},"534":{"id":"/docs/interact/custom-themes-83","page_id":"/docs/interact/custom-themes","tags":[],"type":"text","url":"/docs/interact/custom-themes#what-to-style","content":"**`body.is-cooldown`** — dim the key so the hourglass reads as blocked"},"535":{"id":"/docs/interact/custom-themes-84","page_id":"/docs/interact/custom-themes","tags":[],"type":"text","url":"/docs/interact/custom-themes#what-to-style","content":"`.animated-background` is a full-row fill used by `legacy` and `retro`. Most themes hide it with `display: none`."},"536":{"id":"/docs/interact/custom-themes-85","page_id":"/docs/interact/custom-themes","tags":[],"type":"text","url":"/docs/interact/custom-themes#compact-interact","content":"When compact, global CSS strips border, background, and shadow from `.interact-summary` and draws `INTERACT` as uppercase outlined type. Keep row decorations on `.option-container` only. Pseudos on `.interact-summary` will still show on the compact label."},"537":{"id":"/docs/interact/custom-themes-86","page_id":"/docs/interact/custom-themes","tags":[],"type":"text","url":"/docs/interact/custom-themes#compact-interact","content":"To force compact label color (light themes need this so it stays white):"},"538":{"id":"/docs/interact/custom-themes-87","page_id":"/docs/interact/custom-themes","tags":[],"type":"text","url":"/docs/interact/custom-themes#hold-contrast","content":"While holding, the letter keeps its idle color and gets a `--on-accent` stroke so it stays readable as `--primary` fills the key. If the fill and the letter are the same color, that stroke is what keeps E visible."},"539":{"id":"/docs/interact/custom-themes-88","page_id":"/docs/interact/custom-themes","tags":[],"type":"text","url":"/docs/interact/custom-themes#dui-limits","content":"This prompt is a world sprite, not a fullscreen NUI overlay."},"540":{"id":"/docs/interact/custom-themes-89","page_id":"/docs/interact/custom-themes","tags":[],"type":"text","url":"/docs/interact/custom-themes#dui-limits","content":"Keep `html, body` background transparent. `style.css` already does this."},"541":{"id":"/docs/interact/custom-themes-90","page_id":"/docs/interact/custom-themes","tags":[],"type":"text","url":"/docs/interact/custom-themes#dui-limits","content":"`backdrop-filter` cannot blur GTA. CEF only composites the DUI texture, so a blur with nothing behind it paints black. Use solid or slightly transparent `--surface` fills."},"542":{"id":"/docs/interact/custom-themes-91","page_id":"/docs/interact/custom-themes","tags":[],"type":"text","url":"/docs/interact/custom-themes#dui-limits","content":"Keep the layout compact. Large shadows and oversized rows read poorly in the world."},"543":{"id":"/docs/interact/custom-themes-92","page_id":"/docs/interact/custom-themes","tags":[],"type":"text","url":"/docs/interact/custom-themes#dui-limits","content":"Prefer `rem` over `px`. Animate `transform` and `opacity` only."},"544":{"id":"/docs/interact/custom-themes-93","page_id":"/docs/interact/custom-themes","tags":[],"type":"text","url":"/docs/interact/custom-themes#dui-limits","content":"DINPRO is self-hosted in `web/fonts/`. To use another face, add an `@font-face` in your theme file (see `legacy.css`) and set `--font`."},"545":{"id":"/docs/interact/custom-themes-94","page_id":"/docs/interact/custom-themes","tags":[],"type":"text","url":"/docs/interact/custom-themes#dui-limits","content":"Built-in themes live in `web/themes/`. `modern.css` is the default HUD. `cyber.css`, `vice.css`, and `noir.css` show how far you can push shape without changing the HTML."},"546":{"id":"/docs/interact","page_id":"/docs/interact","type":"page","content":"Sleepless Interact","breadcrumbs":["Docs","Free Resources","Interact"],"tags":[],"url":"/docs/interact"},"547":{"id":"/docs/interact-0","page_id":"/docs/interact","type":"heading","tags":[],"url":"/docs/interact#features","content":"Features"},"548":{"id":"/docs/interact-1","page_id":"/docs/interact","type":"heading","tags":[],"url":"/docs/interact#dependencies","content":"Dependencies"},"549":{"id":"/docs/interact-2","page_id":"/docs/interact","type":"heading","tags":[],"url":"/docs/interact#ox_target-compatibility","content":"ox_target Compatibility"},"550":{"id":"/docs/interact-3","page_id":"/docs/interact","type":"heading","tags":[],"url":"/docs/interact#installation","content":"Installation"},"551":{"id":"/docs/interact-4","page_id":"/docs/interact","type":"heading","tags":[],"url":"/docs/interact#download-the-resource-step","content":"Download the Resource"},"552":{"id":"/docs/interact-5","page_id":"/docs/interact","type":"heading","tags":[],"url":"/docs/interact#add-to-server-step","content":"Add to Server"},"553":{"id":"/docs/interact-6","page_id":"/docs/interact","type":"heading","tags":[],"url":"/docs/interac